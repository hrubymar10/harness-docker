# All values are auto-detected or have defaults. Copy this file to config/.env
# only for overrides. Paths must be absolute.

# ── Host identity and harness state ─────────────────────────────
# HOST_USER=                         # default: $(whoami)
# HOST_UID=                          # default: $(id -u)
# HOST_HOME=                         # default: $HOME
# CLAUDE_CONFIG_DIR=                 # default: $HOME/.claude; export this on the host too
# CODEX_HOME=                        # default: $HOME/.codex
# PI_CODING_AGENT_DIR=               # default: $HOME/.pi/agent
# PI_PACKAGE_DIR=                    # optional separate pi package storage
# VIBE_HOME=                         # default: $HOME/.vibe
# OPENCODE_CONFIG_DIR=               # default: ${XDG_CONFIG_HOME:-$HOME/.config}/opencode
# XDG_CONFIG_HOME=                   # optional OpenCode config base override
# XDG_DATA_HOME=                     # optional OpenCode auth/data base override

# ── Harness authentication ──────────────────────────────────────
# OPENAI_API_KEY=                    # optional Codex/API authentication
# ANTHROPIC_API_KEY=                 # optional Claude/OpenCode API authentication
# MISTRAL_API_KEY=                   # optional Vibe/API authentication

# ── Git hosts and identity ──────────────────────────────────────
# GITHUB_TOKEN=                      # default: $(gh auth token)
# GITLAB_TOKEN=                      # default: token from host glab configuration
# GITLAB_HOST=                       # default: gitlab.com
# GIT_USER_NAME=                     # default: $(git config user.name)
# GIT_USER_EMAIL=                    # default: $(git config user.email)
# GIT_AUTH_USER=                     # optional generic HTTPS credential user
# GIT_AUTH_TOKEN=                    # optional generic HTTPS credential token
# GIT_PROTECTED_BRANCHES=main master
# GIT_PROTECTED_BRANCH_EXEMPT_REPOS= # space-separated host/org/repo destinations
# GOPRIVATE=
# GONOSUMDB=                         # default: same as GOPRIVATE

# SSH agent forwarding is auto-detected from SSH_AUTH_SOCK.
# SSH_RELAY_HOST=host.docker.internal
# SSH_RELAY_PORT=19922

# ── Container behavior and resources ────────────────────────────
# CONTAINER_SHELL=                   # auto-detected; bash, zsh, fish, dash, elvish,
#                                    # ksh, mksh, nu, oksh, tcsh, and yash are available
# DOCKER_MEMORY_LIMIT=8g             # 0 means unlimited
# DOCKER_GPU=                        # all, 0, or a comma-separated NVIDIA GPU list

# ── Build customization and version pins ────────────────────────
# GO_VERSION=                        # default: detected host Go version
# EXTRA_PACKAGES=                    # additional Alpine packages, space-separated
# EXTRA_GO_PACKAGES=                 # additional pinned go install targets
# EXTRA_NPM_PACKAGES=                # additional global npm packages
# CC_VERSION=                        # Claude Code version; empty means latest
# CODEX_VERSION=                     # Codex CLI npm version; empty means latest
# PI_VERSION=                        # pi npm version; empty means latest
# VIBE_VERSION=                      # mistral-vibe package version; empty means latest
# OPENCODE_VERSION=                  # opencode-ai npm version; empty means latest

# ── AWS credential proxy consumer ───────────────────────────────
# AWS_AI_PROXY_ENABLED=false
# AWS_AI_PROXY_URL=http://host.docker.internal:9998

# ── Beeper ──────────────────────────────────────────────────────
# BEEPER_BIND=127.0.0.1:9999
# BEEPER_ALLOW=127.0.0.0/8

# ── Notifications ───────────────────────────────────────────────
# config/harness-notifier is mounted as each harness-specific notifier name.
# Copy config/harness-notifier.example there and enable one integration.
